foreach(required REFERENCE_EXE CURRENT_EXE ARTIFACT_DIR HISTORICAL_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing baseline test parameter: ${required}")
    endif()
endforeach()
set(reference_dir "${ARTIFACT_DIR}/reference")
set(actual_dir "${ARTIFACT_DIR}/actual")
file(MAKE_DIRECTORY "${reference_dir}" "${actual_dir}")
execute_process(COMMAND "${REFERENCE_EXE}" "${reference_dir}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 65)
file(WRITE "${ARTIFACT_DIR}/reference.log" "${output}\n${errors}")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Frozen previous core failed (${result}):\n${output}\n${errors}")
endif()
execute_process(COMMAND "${CURRENT_EXE}" "${reference_dir}" "${actual_dir}" "${HISTORICAL_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 65)
file(WRITE "${ARTIFACT_DIR}/comparison.log" "${output}\n${errors}")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Quad3D regression failed (${result}). Traces: ${ARTIFACT_DIR}\n${output}\n${errors}")
endif()
message(STATUS "${output}")
message(STATUS "Quad3D baseline artifacts: ${ARTIFACT_DIR}")
